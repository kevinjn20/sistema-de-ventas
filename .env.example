# Copiar a .env (no commitear). Valores locales por defecto.
POSTGRES_DB=sistema_ventas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Puertos publicados (cámbialos si están ocupados)
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Solo para ejecución local sin Docker (Spring Boot fuera de compose).
# Dentro de Docker Compose el backend usa jdbc:postgresql://postgres:5432/...
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sistema_ventas
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# En Docker Compose se usa "update" para crear el esquema en el primer arranque.
# En producción real con migraciones (Flyway/Liquibase) usa "validate".
SPRING_JPA_HIBERNATE_DDL_AUTO=update

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (generar uno propio en produccion, min. 32 caracteres)
JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres-en-produccion-123456
JWT_EXPIRATION_MS=86400000

# Admin inicial solo para desarrollo local (cambiar en produccion)
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123

# Umbral de stock bajo para el dashboard
APP_DASHBOARD_STOCK_MINIMO=5
